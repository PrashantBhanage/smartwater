# Monorepo-level gitignore
# -------------------------

# Aider AI assistant artifacts
.aider*

# IDE / editor
.idea/
.vscode/
*.iml

# Java build output (Spring Boot)
target/

# Node / React build output
node_modules/
dist/
dist-ssr/

# Environment files
.env
.env.local
*.env
*.env.local

# Frontend-specific env files
smartwaterfrontend/.env
smartwaterfrontend/.env.local

# Local dev secrets (Spring Boot — also gitignored in the sub-project)
smartwaterbackend/src/main/resources/application-local.properties

# OS
.DS_Store
